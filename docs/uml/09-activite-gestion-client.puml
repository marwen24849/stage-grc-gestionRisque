@startuml
start
:Utilisateur accède au module client;
:Angular appelle GET /api/clients ou POST /api/clients;
if (Action = créer un client) then (oui)
  :Vérifier les droits ADMIN;
  :Valider le DTO client;
  :Vérifier l’unicité de l’email;
  :ClientServiceImpl.create();
  :ClientRepository.save(client);
  :Retourner ClientResponseDTO;
else (non)
  :ClientServiceImpl.findAll();
